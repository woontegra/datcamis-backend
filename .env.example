# Development ve production değerlerini ayrı ortam dosyalarında tutun.
# Bu dosya yalnızca anahtarların listesidir; gerçek parola veya üçüncü parti anahtar koyulmaz.

NODE_ENV=development
PORT=4010
LOG_LEVEL=info

# Yerel PostgreSQL. Production'da ayrı bir veritabanı kullanın.
DATABASE_URL=postgresql://datcamis_app:CHANGE_ME@127.0.0.1:5434/datcamis?schema=public

# En az 32 karakter. Development ve production sırları farklı olmalıdır.
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Virgülle ayrılmış storefront origin listesi.
CORS_ORIGINS=http://localhost:3010,http://127.0.0.1:3010

# local | s3
# s3 seçilirse bucket ve endpoint dolu olmalıdır. Sahte anahtar yazmayın.
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=storage
# S3_BUCKET=
# S3_ENDPOINT=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Ödeme ve kargo sağlayıcıları credential gelene kadar unconfigured kalır.
PAYMENT_PROVIDER=unconfigured
SHIPPING_PROVIDER=unconfigured

# Yalnızca development seed. Production'da bu kullanıcıyı oluşturmayın.
SEED_ADMIN_EMAIL=owner@datcamis.local
SEED_ADMIN_PASSWORD=change-me-dev-only
SEED_ADMIN_NAME=DatçaMis Owner
